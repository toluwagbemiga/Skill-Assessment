# RPC endpoint for Polygon Amoy. The public one below works; swap in Alchemy/Infura if it rate-limits.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Deployer private key (no 0x prefix is fine either way). NEVER commit the real value.
PRIVATE_KEY=

# Optional: only needed for `npm run verify:amoy`
POLYGONSCAN_API_KEY=

# Optional: set to true to print a gas table when running the tests
REPORT_GAS=false
