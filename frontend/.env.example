# Backend API
# Leave this UNSET for local dev and Codespaces. The app then calls the relative
# path /api, which the Vite dev server proxies to the backend (vite.config.ts).
# Same-origin means no CORS preflight, and no second forwarded port to expose.
# Set it only to point at a backend on a different origin, e.g. in production.
# VITE_API_BASE_URL=https://api.example.com

# Feature flags
VITE_ENABLE_AI_HUB=false

# ── On-chain property registry (Polygon Amoy, chainId 80002) ──────────────
# Printed by `npm run deploy:amoy` inside ../contracts. Until this is set, the
# Blockchain Record card renders a "not configured" notice instead of failing.
VITE_PROPERTY_REGISTRY_ADDRESS=

# Optional: override the public Amoy RPC used for read-only calls.
VITE_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
